# CareerHive AI Environment Configuration

# TinyFish API Key (Obtain from https://agent.tinyfish.ai/api-keys)
TINYFISH_API_KEY=your_tinyfish_api_key_here

# Database Configuration (SQLite default, PostgreSQL supported)
DATABASE_URL=sqlite+aiosqlite:///./careerhive.db

# LLM Provider Configuration (ollama | openai | heuristic)
LLM_PROVIDER=heuristic
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OPENAI_API_KEY=

# Server Configuration
HOST=0.0.0.0
PORT=8000
SECRET_KEY=careerhive_super_secret_key_change_in_production
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
